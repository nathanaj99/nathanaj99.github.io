---
import NameMark from './NameMark.astro';
import { site } from '../data/site';
import { url } from '../lib/url';

const year = new Date().getFullYear();
// Internal pages on the left, everything off-site on the right, so nothing
// (the CV in particular) is listed twice.
const pages = site.nav.filter((item) => !item.external);
const elsewhere = site.links.filter(
  (link) => !['Email', 'CV', 'X'].includes(link.label),
);
---

<footer class="foot">
  <!-- One last disc, cropped by the edge of the page. -->
  <svg class="foot__arc" viewBox="0 0 400 400" aria-hidden="true">
    <circle cx="200" cy="200" r="199" fill="none" stroke="currentColor" stroke-width="1.25" />
    <circle cx="200" cy="200" r="122" fill="none" stroke="currentColor" stroke-width="1.25" />
  </svg>

  <div class="frame foot__inner">
    <div class="foot__grid grid">
      <div class="foot__identity">
        <NameMark variant="footer" />
        <p class="foot__note">{site.contactNote}</p>
        <a class="foot__email" href={`mailto:${site.email}`}>{site.email}</a>
      </div>

      <nav class="foot__col foot__col--pages" aria-label="Footer">
        <p class="label foot__colHead">Pages</p>
        <ul>
          <li><a class="link-quiet" href={url('/')}>Home</a></li>
          {
            pages.map((item) => (
              <li>
                <a class="link-quiet" href={url(item.href)}>
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div class="foot__col">
        <p class="label foot__colHead">Elsewhere</p>
        <ul>
          {
            elsewhere.map((link) => (
              <li>
                <a
                  class="link-quiet"
                  href={link.href.startsWith('/') ? url(link.href) : link.href}
                  target={link.external ? '_blank' : undefined}
                  rel={link.external ? 'noopener' : undefined}
                >
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <div class="foot__base">
      <p class="label">© {year} {site.name}</p>
      <p class="label foot__built">{site.roleLine}</p>
    </div>
  </div>
</footer>

<style>
  .foot {
    position: relative;
    overflow: hidden;
    margin-top: var(--section-y);
    background: var(--ink);
    color: var(--on-dark);
  }

  .foot__arc {
    position: absolute;
    right: -13rem;
    bottom: -17rem;
    width: min(38rem, 70vw);
    height: auto;
    color: var(--on-dark);
    opacity: 0.13;
    pointer-events: none;
  }

  .foot__inner {
    position: relative;
    padding-block: clamp(3.5rem, 7vw, 6.5rem) 2rem;
  }

  .foot__grid {
    row-gap: var(--s-5);
  }

  .foot__identity {
    grid-column: 1 / span 6;
  }

  .foot__note {
    margin-top: var(--s-3);
    color: var(--on-dark-60);
    max-width: 26ch;
  }

  .foot__email {
    display: inline-block;
    margin-top: 0.4rem;
    font-size: var(--step-1);
    text-decoration: none;
    border-bottom: 1px solid var(--on-dark-rule);
    padding-bottom: 0.1em;
    transition:
      color 200ms ease,
      border-color 200ms ease;
  }

  .foot__email:hover {
    color: var(--gold);
    border-bottom-color: var(--gold);
  }

  .foot__col {
    grid-column: span 3;
  }

  .foot__col--pages {
    grid-column: 8 / span 2;
  }

  .foot__colHead {
    color: var(--on-dark-60);
    padding-bottom: 0.85rem;
    margin-bottom: 0.85rem;
    border-bottom: 1px solid var(--on-dark-rule);
  }

  .foot__col li + li {
    margin-top: 0.5rem;
  }

  .foot__col .link-quiet {
    color: var(--on-dark);
  }

  .foot__col .link-quiet:hover {
    color: var(--gold);
  }

  .foot__base {
    display: flex;
    justify-content: space-between;
    gap: var(--s-3);
    margin-top: clamp(3rem, 6vw, 5.5rem);
    padding-top: 1.1rem;
    border-top: 1px solid var(--on-dark-rule);
    color: var(--on-dark-60);
  }

  @media (max-width: 60rem) {
    .foot__identity,
    .foot__col,
    .foot__col--pages {
      grid-column: 1 / -1;
    }

    .foot__grid {
      row-gap: var(--s-4);
    }

    .foot__base {
      flex-direction: column;
      gap: 0.4rem;
    }
  }
</style>
