---
/**
 * Quiet sticky rail: three accent discs that jump to each research strand.
 * Minimal motion — current section is marked; hover only brightens a little.
 */
import { getCollection } from 'astro:content';

const strands = (await getCollection('research')).sort((a, b) => a.data.order - b.data.order);

/** Short rail copy — kept out of the way of the content column. */
const railLabel: Record<string, string> = {
  'human-ai': 'Human + AI',
  evaluation: 'Evals',
  'decision-making': 'ML & Policy',
};
---

<nav class="rail" data-strand-rail aria-label="Jump to research strand">
  <ol class="rail__list">
    {
      strands.map((strand) => (
        <li>
          <a
            class="rail__link"
            href={`#${strand.id}`}
            data-rail-link={strand.id}
            title={strand.data.title}
          >
            <span
              class:list={['rail__disc', `rail__disc--${strand.data.accent}`]}
              aria-hidden="true"
            />
            <span class="rail__label">{railLabel[strand.id] ?? strand.data.title}</span>
          </a>
        </li>
      ))
    }
  </ol>
</nav>

<script>
  const root = document.querySelector<HTMLElement>('[data-strand-rail]');
  const links = root ? [...root.querySelectorAll<HTMLAnchorElement>('[data-rail-link]')] : [];
  const sections = links
    .map((link) => document.getElementById(link.dataset.railLink ?? ''))
    .filter((el): el is HTMLElement => Boolean(el));

  if (root && links.length && sections.length) {
    const setActive = (id: string | null) => {
      for (const link of links) {
        const on = link.dataset.railLink === id;
        link.toggleAttribute('data-active', on);
        if (on) link.setAttribute('aria-current', 'true');
        else link.removeAttribute('aria-current');
      }
    };

    // Default to the first strand until scroll settles.
    setActive(sections[0]?.id ?? null);

    const observer = new IntersectionObserver(
      (entries) => {
        // Prefer the entry closest to the upper third of the viewport.
        const visible = entries
          .filter((entry) => entry.isIntersecting)
          .sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top);
        const top = visible[0];
        if (top?.target instanceof HTMLElement) setActive(top.target.id);
      },
      { rootMargin: '-18% 0px -55% 0px', threshold: [0, 0.1, 0.4] },
    );

    sections.forEach((section) => observer.observe(section));
  }
</script>

<style>
  .rail {
    position: fixed;
    z-index: 30;
    top: 50%;
    /* Sit deeper in the left margin so hover labels stay clear of the frame. */
    left: max(0.4rem, calc((100vw - var(--frame-max)) / 2 - 4rem));
    transform: translateY(-50%);
    pointer-events: none;
  }

  .rail__list {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
    pointer-events: auto;
  }

  .rail__link {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    text-decoration: none;
    color: var(--ink-45);
    transition: color 200ms ease;
  }

  .rail__disc {
    display: block;
    width: 0.65rem;
    height: 0.65rem;
    border-radius: 50%;
    flex: none;
    opacity: 0.55;
    box-shadow: 0 0 0 0 transparent;
    transition:
      opacity 220ms ease,
      transform 280ms cubic-bezier(0.2, 0.7, 0.2, 1),
      box-shadow 280ms ease;
  }

  .rail__disc--persimmon {
    background: var(--persimmon);
  }
  .rail__disc--gold {
    background: var(--gold);
  }
  .rail__disc--cobalt {
    background: var(--cobalt);
  }

  .rail__label {
    max-width: 0;
    overflow: hidden;
    opacity: 0;
    white-space: nowrap;
    font-size: 0.625rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    line-height: 1.2;
    transition:
      max-width 280ms ease,
      opacity 200ms ease;
  }

  .rail__link:hover,
  .rail__link:focus-visible,
  .rail__link[data-active] {
    color: var(--ink);
  }

  .rail__link:hover .rail__disc,
  .rail__link:focus-visible .rail__disc,
  .rail__link[data-active] .rail__disc {
    opacity: 1;
    transform: scale(1.15);
  }

  .rail__link[data-active] .rail__disc {
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--ink) 10%, var(--cream));
  }

  /* Labels stay tucked away until hover/focus so the rail stays quiet. */
  .rail__link:hover .rail__label,
  .rail__link:focus-visible .rail__label {
    max-width: 14ch;
    opacity: 1;
  }

  @media (max-width: 72rem) {
    /* Only float when there is empty margin outside the content frame. */
    .rail {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .rail__disc,
    .rail__label {
      transition: none;
    }
  }
</style>
