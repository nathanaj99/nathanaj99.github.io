---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';

import Base from '../layouts/Base.astro';
import NameMark from '../components/NameMark.astro';
import SectionHead from '../components/SectionHead.astro';
import portrait from '../assets/portrait.png';
import { site } from '../data/site';
import { primaryHref, sortPublications, TYPE_LABEL } from '../lib/publications';
import { url } from '../lib/url';

const strands = (await getCollection('research')).sort((a, b) => a.data.order - b.data.order);
const publications = sortPublications(await getCollection('publications'));

const papersIn = (id: string) =>
  publications.filter((entry) => entry.data.themes.includes(id));

/** Up to two representative papers per strand: the newest flagged `selected`. */
const representative = (id: string) => {
  const papers = papersIn(id);
  const picked = papers.filter((entry) => entry.data.selected);
  return (picked.length > 0 ? picked : papers).slice(0, 2);
};

const paperMeta = (data: (typeof publications)[number]['data']) => {
  const status = data.status ?? data.venueShort ?? data.venue ?? TYPE_LABEL[data.type];
  return `${status}, ${data.year}`;
};

const primaryLinks = site.links.filter((link) => link.primary);
---

<Base transparentHeader>
  <!-- Identity ---------------------------------------------------------- -->
  <section class="hero frame">
    <div class="hero__layout grid">
      <div class="hero__who">
        <NameMark />
        <p class="hero__role">{site.roleLine}</p>
      </div>

      <figure class="portrait">
        <span class="portrait__field" aria-hidden="true"></span>
        <span class="portrait__ring" aria-hidden="true"></span>
        <span class="portrait__dot" aria-hidden="true"></span>
        <Image
          class="portrait__img"
          src={portrait}
          widths={[280, 420, 560]}
          sizes="(max-width: 52rem) 7rem, 14rem"
          alt="Nathanael Jo"
          loading="eager"
        />
      </figure>

      <div class="hero__lede">
        <p class="hero__statement">{site.statement}</p>

        <a class="hero__bio label" href={url('/bio')}>
          Full bio
          <span aria-hidden="true">→</span>
        </a>

        <ul class="hero__links">
          {
            primaryLinks.map((link) => (
              <li>
                <a
                  class="label link-quiet"
                  href={link.href.startsWith('/') ? url(link.href) : link.href}
                  target={link.external ? '_blank' : undefined}
                  rel={link.external ? 'noopener' : undefined}
                >
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <!-- Research strands --------------------------------------------------- -->
  <div class="strands frame" data-strands>
    <!-- Decorative spine: a light vertical rule threaded through accent discs. -->
    <div class="strands__spine" aria-hidden="true">
      <span class="strands__track"></span>
      <span class="strands__fill" data-strands-fill></span>
    </div>

    {
      strands.map((strand) => {
        const shown = representative(strand.id);
        return (
          <section class="strand" id={strand.id} aria-labelledby={`${strand.id}-title`} data-strand>
            <span
              class:list={['strand__node', `strand__node--${strand.data.accent}`]}
              data-strand-node
              aria-hidden="true"
            />

            <SectionHead index={String(strand.data.order).padStart(2, '0')} title="" />

            <div class="strand__body grid" data-reveal>
              <div class="strand__main">
                <h2 class="strand__title" id={`${strand.id}-title`}>
                  {strand.data.title}
                </h2>
                <p class="strand__question">{strand.data.question}</p>
              </div>

              <div class="strand__side">
                <p class="strand__summary">{strand.data.summary}</p>

                <ul class="strand__papers">
                  {shown.map((entry) => {
                    const href = primaryHref(entry.data);
                    return (
                      <li class="strand__paper">
                        <span class="strand__bullet" aria-hidden="true" />
                        {href ? (
                          <a
                            class="strand__paperTitle"
                            href={href}
                            target="_blank"
                            rel="noopener"
                          >
                            {entry.data.title}
                          </a>
                        ) : (
                          <span class="strand__paperTitle">{entry.data.title}</span>
                        )}
                        <p class="strand__paperMeta">{paperMeta(entry.data)}</p>
                      </li>
                    );
                  })}
                </ul>

                <a class="strand__more label" href={url(`/research#${strand.id}`)}>
                  More papers
                  <span aria-hidden="true">→</span>
                </a>
              </div>
            </div>
          </section>
        );
      })
    }
  </div>

  <!-- Contact ------------------------------------------------------------ -->
  <section class="contact" aria-labelledby="contact-head">
    <div class="frame">
      <SectionHead title="Contact" tone="field" meta={site.affiliation} />
      <h2 class="sr-only" id="contact-head">Contact</h2>

      <div class="contact__grid grid">
        <p class="contact__note">{site.contactNote}</p>

        <div class="contact__side">
          <a class="contact__email" href={`mailto:${site.email}`}>{site.email}</a>
          <ul class="contact__links">
            <li>
              <a class="label link-quiet" href={url('/bio')}>
                Full bio <span aria-hidden="true">→</span>
              </a>
            </li>
            <li>
              <a class="label link-quiet" href={url('/research')}>
                All papers <span aria-hidden="true">→</span>
              </a>
            </li>
            <li>
              <a class="label link-quiet" href={url('/cv.pdf')} target="_blank" rel="noopener">
                Curriculum vitae <span aria-hidden="true">↓</span>
              </a>
            </li>
          </ul>
        </div>
      </div>
    </div>
  </section>
</Base>

<script>
  /**
   * Spine play: as the visitor scrolls through the strand block, a soft fill
   * grows down the vertical rule, and each disc settles open when its section
   * crosses the middle of the viewport. Quiet, reversible, no pointer chasing.
   */
  const root = document.querySelector<HTMLElement>('[data-strands]');
  const fill = root?.querySelector<HTMLElement>('[data-strands-fill]');
  const sections = root ? [...root.querySelectorAll<HTMLElement>('[data-strand]')] : [];

  if (root && fill && sections.length) {
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    const updateFill = () => {
      const rect = root.getBoundingClientRect();
      const view = window.innerHeight;
      // Start filling when the spine enters the upper half; finish near the bottom.
      const start = view * 0.55;
      const end = view * 0.3;
      const raw = (start - rect.top) / (start - end + rect.height);
      const progress = Math.min(1, Math.max(0, raw));
      fill.style.transform = `translateX(-50%) scaleY(${progress.toFixed(4)})`;
    };

    if (reduce) {
      fill.style.transform = 'translateX(-50%) scaleY(1)';
      sections.forEach((section) => section.setAttribute('data-active', ''));
    } else {
      updateFill();
      window.addEventListener('scroll', updateFill, { passive: true });
      window.addEventListener('resize', updateFill, { passive: true });

      const observer = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            entry.target.toggleAttribute('data-active', entry.isIntersecting);
          }
        },
        { rootMargin: '-28% 0px -42% 0px', threshold: 0 },
      );
      sections.forEach((section) => observer.observe(section));
    }
  }
</script>

<style>
  /* --- identity ------------------------------------------------------- */

  .hero {
    padding-top: clamp(1.75rem, 4vw, 3.25rem);
    padding-bottom: 0.35rem;
  }

  /* Name+role and lede stack on the left; portrait spans both rows and
     centres in its column so it never hugs the right edge. */
  .hero__layout {
    align-items: center;
    row-gap: clamp(1.15rem, 2vw, 1.6rem);
  }

  .hero__who {
    grid-column: 1 / span 8;
    grid-row: 1;
    display: flex;
    flex-direction: column;
    align-items: start;
  }

  .hero__who :global(.name) {
    max-width: 100%;
  }

  .hero__role {
    margin-top: 0.35rem;
    font-size: var(--step-1);
    letter-spacing: -0.01em;
    color: var(--ink-80);
  }

  .hero__lede {
    grid-column: 1 / span 8;
    grid-row: 2;
  }

  .hero__statement {
    font-size: clamp(1.125rem, 0.95rem + 0.85vw, 1.5rem);
    line-height: 1.32;
    letter-spacing: -0.015em;
    max-width: 34ch;
  }

  .hero__bio {
    display: inline-flex;
    align-items: center;
    gap: 0.55em;
    margin-top: clamp(0.9rem, 1.6vw, 1.25rem);
    text-decoration: none;
    border-bottom: 1px solid var(--rule-strong);
    padding-bottom: 0.35em;
    transition:
      color 200ms ease,
      border-color 200ms ease,
      gap 300ms cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  .hero__bio:hover {
    color: var(--persimmon-ink);
    border-bottom-color: var(--persimmon);
    gap: 0.9em;
  }

  .hero__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem 1.35rem;
    margin-top: clamp(1rem, 1.8vw, 1.35rem);
  }

  /* Portrait placement. Shared motif styles (gold field, optical shift, hover)
     live in global.css. */
  .portrait {
    grid-column: 9 / span 4;
    grid-row: 1 / span 2;
    justify-self: start;
    align-self: center;
    width: min(100%, 15rem);
    aspect-ratio: 1;
    margin: 0;
  }

  .portrait :global(picture),
  .portrait :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    border-radius: 50%;
  }

  .portrait :global(img) {
    object-fit: cover;
  }

  /* --- research strands + spine ---------------------------------------- */

  .strands {
    --spine-gutter: 2.15rem;
    --spine-size: 1.15rem;
    --spine-inset: 0.85rem;
    position: relative;
    /* Extra left inset so the spine never collides with type. */
    padding-left: calc(var(--frame-pad) + var(--spine-gutter));
  }

  .strands__spine {
    position: absolute;
    top: clamp(1.65rem, 3vw, 2.35rem);
    bottom: 1.25rem;
    left: calc(var(--frame-pad) + var(--spine-gutter) / 2);
    width: var(--spine-size);
    transform: translateX(-50%);
    pointer-events: none;
  }

  .strands__track,
  .strands__fill {
    position: absolute;
    left: 50%;
    top: 0;
    bottom: 0;
    width: 1px;
    transform: translateX(-50%);
    transform-origin: top center;
  }

  .strands__track {
    background: var(--rule);
  }

  .strands__fill {
    background: var(--ink);
    opacity: 0.28;
    transform: translateX(-50%) scaleY(0);
    will-change: transform;
  }

  .strand {
    position: relative;
    padding-top: clamp(1.5rem, 3vw, 2.25rem);
  }

  /* Keep index / body clear of the spine discs. */
  .strand :global(.head),
  .strand__body {
    padding-left: var(--spine-inset);
  }

  /* Accent disc sits on the spine, aligned with the section index rule. */
  .strand__node {
    position: absolute;
    left: calc(var(--spine-gutter) / -2);
    top: calc(clamp(1.5rem, 3vw, 2.25rem) + 0.95rem);
    width: var(--spine-size);
    height: var(--spine-size);
    border-radius: 50%;
    transform: translateX(-50%) scale(0.72);
    opacity: 0.45;
    transition:
      transform 520ms cubic-bezier(0.2, 0.7, 0.2, 1),
      opacity 420ms ease;
    z-index: 1;
  }

  .strand__node--persimmon {
    background: var(--persimmon);
  }
  .strand__node--gold {
    background: var(--gold);
  }
  .strand__node--cobalt {
    background: var(--cobalt);
  }

  .strand[data-active] .strand__node {
    transform: translateX(-50%) scale(1);
    opacity: 1;
  }

  .strand[data-active] .strand__node--persimmon {
    animation: node-pulse-persimmon 2.6s ease-in-out infinite;
  }
  .strand[data-active] .strand__node--gold {
    animation: node-pulse-gold 2.6s ease-in-out infinite;
  }
  .strand[data-active] .strand__node--cobalt {
    animation: node-pulse-cobalt 2.6s ease-in-out infinite;
  }

  @keyframes node-pulse-persimmon {
    0%,
    100% {
      box-shadow: 0 0 0 4px color-mix(in srgb, var(--persimmon) 22%, var(--cream));
    }
    50% {
      box-shadow: 0 0 0 9px color-mix(in srgb, var(--persimmon) 8%, var(--cream));
    }
  }

  @keyframes node-pulse-gold {
    0%,
    100% {
      box-shadow: 0 0 0 4px color-mix(in srgb, var(--gold) 34%, var(--cream));
    }
    50% {
      box-shadow: 0 0 0 9px color-mix(in srgb, var(--gold) 12%, var(--cream));
    }
  }

  @keyframes node-pulse-cobalt {
    0%,
    100% {
      box-shadow: 0 0 0 4px color-mix(in srgb, var(--cobalt) 22%, var(--cream));
    }
    50% {
      box-shadow: 0 0 0 9px color-mix(in srgb, var(--cobalt) 8%, var(--cream));
    }
  }

  .strand__body {
    margin-top: clamp(0.85rem, 1.6vw, 1.25rem);
    align-items: start;
    row-gap: var(--s-3);
  }

  /* Slightly narrower title column; the denser summary/papers get the rest. */
  .strand__main {
    grid-column: 1 / span 4;
  }

  .strand__title {
    font-size: var(--step-2);
    font-weight: 500;
    line-height: 1.12;
    letter-spacing: -0.02em;
    max-width: 20ch;
  }

  .strand__question {
    margin-top: 0.85rem;
    font-size: var(--step-0);
    line-height: 1.4;
    color: var(--ink-60);
    max-width: 30ch;
  }

  .strand__side {
    grid-column: 6 / span 7;
  }

  .strand__summary {
    color: var(--ink-80);
    max-width: 58ch;
  }

  .strand__papers {
    margin-top: 1.35rem;
  }

  .strand__paper + .strand__paper {
    margin-top: 1rem;
  }

  .strand__paper {
    position: relative;
    padding-left: 1.1rem;
  }

  .strand__bullet {
    position: absolute;
    left: 0;
    top: 0.55em;
    width: 0.35rem;
    height: 0.35rem;
    border-radius: 50%;
    background: var(--ink);
    opacity: 0.35;
  }

  .strand__paperTitle {
    display: inline;
    font-size: var(--step-0);
    line-height: 1.4;
    color: inherit;
    text-decoration: none;
    background-image: linear-gradient(var(--rule-strong), var(--rule-strong));
    background-size: 100% 1px;
    background-repeat: no-repeat;
    background-position: 0 100%;
    padding-bottom: 0.05em;
    transition:
      color 180ms ease,
      background-image 180ms ease;
  }

  a.strand__paperTitle:hover {
    color: var(--persimmon-ink);
    background-image: linear-gradient(var(--persimmon-ink), var(--persimmon-ink));
  }

  .strand__paperMeta {
    margin-top: 0.25rem;
    font-size: var(--step--1);
    color: var(--ink-45);
  }

  .strand__more {
    display: inline-flex;
    align-items: baseline;
    gap: 0.55em;
    margin-top: 1.25rem;
    text-decoration: none;
    transition: color 200ms ease;
  }

  .strand__more:hover {
    color: var(--persimmon-ink);
  }

  /* --- contact ---------------------------------------------------------- */

  .contact {
    margin-top: clamp(1.5rem, 3vw, 2.25rem);
    padding-block: clamp(1.15rem, 2.2vw, 1.6rem) clamp(1.35rem, 2.5vw, 1.85rem);
    background: var(--gold);
  }

  :global(.foot) {
    margin-top: 0;
  }

  .contact__grid {
    margin-top: 0.85rem;
    align-items: baseline;
    row-gap: var(--s-2);
  }

  .contact__note {
    grid-column: 1 / span 6;
    font-size: var(--step-0);
    line-height: 1.3;
    letter-spacing: -0.01em;
    max-width: 28ch;
  }

  .contact__side {
    grid-column: 8 / span 5;
    padding-top: 0;
  }

  .contact__email {
    font-size: var(--step-0);
    letter-spacing: -0.01em;
    text-decoration: none;
    border-bottom: 1px solid rgba(31, 29, 25, 0.35);
    padding-bottom: 0.1em;
    transition: border-color 200ms ease;
  }

  .contact__email:hover {
    border-bottom-color: var(--ink);
  }

  .contact__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.35rem;
    margin-top: 0.75rem;
  }

  .contact__links .link-quiet {
    color: var(--ink);
  }

  .contact__links .link-quiet:hover {
    color: var(--ink);
    border-bottom-color: var(--ink);
  }

  /* --- responsive -------------------------------------------------------- */

  @media (max-width: 66rem) {
    .strand__main,
    .strand__side {
      grid-column: 1 / -1;
    }

    .contact__note {
      grid-column: 1 / span 7;
    }
  }

  @media (max-width: 52rem) {
    .hero {
      padding-top: clamp(1.35rem, 3.5vw, 2.25rem);
    }

    /* Stack: name+title, then portrait, then the rest — keeps name→role
       spacing identical to desktop (no shared row with the photo). */
    .hero__layout {
      grid-template-columns: minmax(0, 1fr);
      row-gap: 0.85rem;
      align-items: start;
    }

    .hero__who,
    .hero__lede,
    .portrait {
      grid-column: 1;
      grid-row: auto;
    }

    .hero__who {
      margin-bottom: 0;
    }

    .portrait {
      justify-self: start;
      align-self: start;
      width: 6.75rem;
      margin-top: 0.15rem;
      margin-bottom: 0.35rem;
    }

    .hero__lede {
      margin-top: 0.25rem;
    }

    .strands {
      --spine-gutter: 1.75rem;
      --spine-size: 0.95rem;
      --spine-inset: 0.65rem;
      padding-left: calc(var(--frame-pad) + var(--spine-gutter));
    }

    .contact__note,
    .contact__side {
      grid-column: 1 / -1;
    }

    .contact__side {
      padding-top: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .strand__node {
      transform: translateX(-50%);
      opacity: 1;
      transition: none;
    }

    .strand[data-active] .strand__node--persimmon,
    .strand[data-active] .strand__node--gold,
    .strand[data-active] .strand__node--cobalt {
      animation: none;
      box-shadow: 0 0 0 5px color-mix(in srgb, var(--ink) 8%, var(--cream));
    }

    .strands__fill {
      transform: translateX(-50%) scaleY(1);
    }
  }
</style>
